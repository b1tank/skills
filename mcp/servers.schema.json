{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "servers"],
  "properties": {
    "version": { "const": 1 },
    "retiredServers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "retiredCredentials": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "credentials": { "type": "object", "additionalProperties": { "type": "string" } },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["transport", "command"],
            "properties": {
              "transport": { "const": "stdio" },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "envPass": { "type": "array", "items": { "type": "string" } },
              "excludeTargets": { "type": "array", "items": { "type": "string" } },
              "mcporter": { "$ref": "#/$defs/stdioServer" }
            }
          },
          {
            "type": "object",
            "required": ["transport", "url"],
            "properties": {
              "transport": { "const": "http" },
              "url": { "type": "string", "format": "uri" },
              "bearerEnv": { "type": "string" },
              "excludeTargets": { "type": "array", "items": { "type": "string" } },
              "mcporter": { "$ref": "#/$defs/stdioServer" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "stdioServer": {
      "type": "object",
      "required": ["transport", "command"],
      "properties": {
        "transport": { "const": "stdio" },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "envPass": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
